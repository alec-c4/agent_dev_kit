#!/usr/bin/env bash
# kit — Agent Dev Kit CLI (works from fish, zsh, bash, or any $SHELL)
#
# Kit maintenance scripts are bash. This wrapper runs them with bash explicitly
# so your interactive shell does not matter.
#
# Usage:
#   ./scripts/kit install [--target=cursor|claude|codex|antigravity|both|all] [--project] [--dry-run] [--force]
#   ./scripts/kit compile
#   ./scripts/kit validate [--phase=1]
#   ./scripts/kit validate-skills --pack=core [--report=packs/core/validate-report.md]
#   ./scripts/kit deploy-skills --pack=core [--scope=global|project|both]
#   ./scripts/kit deploy-workflows [--scope=global|project|both]
#   ./scripts/kit intake <work_ref> [--paste] [--file=path] [--dry-run]
#   ./scripts/kit sync-tracker [--dry-run]
#   ./scripts/kit deploy-hooks [--scope=global|project] [--target=claude|cursor|both] [--review-gate]
#   ./scripts/kit validate-handoff <work_ref> [--file=path]
#   ./scripts/kit detect-stack [--write-profile] [path]
#   ./scripts/kit sync-rules [--dry-run] [--rules-dir DIR ...]
#   ./scripts/kit configure [--target=cursor|claude|both] [--init-config] [--disable-attribution] [--dry-run]
#   ./scripts/kit shell-info [--json]
#   ./scripts/kit register [path]
#   ./scripts/kit status [--project=PATH] [--all] [--json] [--watch]
#   ./scripts/kit board
#   ./scripts/kit findings list|append|gate|close|wontfix [--work-ref R] [--run CMD]
#   ./scripts/kit lessons list|propose|ack|promote [--stack ID]
#   ./scripts/kit check-patterns [--work-ref R] [--list-sensors]
#   ./scripts/kit run <script-name.sh> [args...]
#
# Examples (same from fish, zsh, or bash):
#   ./scripts/kit install --target=both
#   ./scripts/kit validate --phase=1
#   ./scripts/kit status --watch
#   ./scripts/kit board   # http://127.0.0.1:8787/ — explicit start only
# ---8<---

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/kit-env.sh
source "$SCRIPT_DIR/lib/kit-env.sh"

KIT_DIR="$(kit_root)"
RUNNER="$(kit_bash)"

kit_bun() {
  if ! command -v bun &>/dev/null; then
    echo "ERROR: bun is required for '$1' (install from https://bun.sh)" >&2
    exit 1
  fi
}

usage() {
  # Print the header comment block between the Usage: and the end marker,
  # with the leading "# " stripped. Line numbers would go stale on every edit.
  # BSD sed has no \| alternation, so strip the two prefixes separately.
  sed -n '/^# Usage:/,/^# ---8<---/p' "$0" \
    | sed -e '/^# ---8<---/d' -e 's/^# //' -e 's/^#$//'
  echo "Interactive shell: $(kit_interactive_shell_name) (${SHELL:-unknown})"
  echo "Kit runs scripts with: $RUNNER"
}

if [[ $# -lt 1 ]]; then
  usage >&2
  exit 1
fi

CMD="$1"
shift

case "$CMD" in
  install)
    exec "$RUNNER" "$KIT_DIR/scripts/install.sh" "$@"
    ;;
  compile)
    exec "$RUNNER" "$KIT_DIR/scripts/compile_registry.sh" "$@"
    ;;
  validate)
    exec "$RUNNER" "$KIT_DIR/scripts/validate-registry.sh" "$@"
    ;;
  validate-skills)
    exec "$RUNNER" "$KIT_DIR/scripts/validate-skills.sh" "$@"
    ;;
  deploy-skills)
    exec "$RUNNER" "$KIT_DIR/scripts/deploy-skills.sh" "$@"
    ;;
  deploy-workflows)
    exec "$RUNNER" "$KIT_DIR/scripts/deploy-workflows.sh" "$@"
    ;;
  intake)
    exec "$RUNNER" "$KIT_DIR/scripts/intake-work-item.sh" "$@"
    ;;
  sync-tracker)
    if command -v bun &>/dev/null && [[ -f "$KIT_DIR/packages/kit-runtime/src/cli/sync-tracker-cache.ts" ]]; then
      exec bun "$KIT_DIR/packages/kit-runtime/src/cli/sync-tracker-cache.ts" "$(pwd)" "$@"
    fi
    exec "$RUNNER" "$KIT_DIR/scripts/sync-tracker-cache.sh" "$@"
    ;;
  deploy-hooks)
    exec "$RUNNER" "$KIT_DIR/scripts/deploy-hooks.sh" "$@"
    ;;
  validate-handoff)
    exec "$RUNNER" "$KIT_DIR/scripts/validate-handoff.sh" "$@"
    ;;
  detect-stack)
    exec "$RUNNER" "$KIT_DIR/scripts/detect-stack.sh" "$@"
    ;;
  register)
    kit_bun register
    exec bun "$KIT_DIR/packages/kit-runtime/src/cli/register.ts" "$@"
    ;;
  status)
    kit_bun status
    # Normalize --project=PATH to --project PATH for the Bun CLI
    normalized=()
    for a in "$@"; do
      if [[ "$a" == --project=* ]]; then
        normalized+=(--project "${a#--project=}")
      else
        normalized+=("$a")
      fi
    done
    if ((${#normalized[@]})); then
      exec bun "$KIT_DIR/packages/kit-runtime/src/cli/status.ts" "${normalized[@]}"
    else
      exec bun "$KIT_DIR/packages/kit-runtime/src/cli/status.ts"
    fi
    ;;
  board)
    kit_bun board
    exec bun "$KIT_DIR/packages/kit-runtime/src/cli/board.ts" "$@"
    ;;
  findings)
    kit_bun findings
    exec bun "$KIT_DIR/packages/kit-runtime/src/cli/findings.ts" "$@"
    ;;
  lessons)
    kit_bun lessons
    exec bun "$KIT_DIR/packages/kit-runtime/src/cli/lessons.ts" "$@"
    ;;
  check-patterns)
    kit_bun check-patterns
    exec bun "$KIT_DIR/packages/kit-runtime/src/cli/check-patterns.ts" "$@"
    ;;
  sync-rules)
    exec "$RUNNER" "$KIT_DIR/scripts/sync-cursor-user-rules.sh" "$@"
    ;;
  configure)
    if command -v bun &>/dev/null && [[ -f "$KIT_DIR/packages/kit-runtime/src/cli/configure.ts" ]]; then
      exec bun "$KIT_DIR/packages/kit-runtime/src/cli/configure.ts" "$@"
    fi
    exec python3 "$KIT_DIR/scripts/configure_settings.py" "$@"
    ;;
  shell-info)
    exec "$RUNNER" "$KIT_DIR/scripts/detect-shell.sh" "$@"
    ;;
  run)
    if [[ $# -lt 1 ]]; then
      echo "ERROR: kit run requires a script name (e.g. install.sh)" >&2
      exit 1
    fi
    script="$1"
    shift
    # A bare filename only: a path would let `kit run ../x.sh` execute a script
    # from outside the kit's scripts directory.
    case "$script" in
      */*|..|.)
        echo "ERROR: kit run takes a script name in scripts/, not a path: $script" >&2
        exit 1
        ;;
    esac
    [[ "$script" == *.sh ]] || script="${script}.sh"
    if [[ ! -f "$KIT_DIR/scripts/$script" ]]; then
      echo "ERROR: no such kit script: scripts/$script" >&2
      exit 1
    fi
    exec "$RUNNER" "$KIT_DIR/scripts/$script" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "ERROR: unknown kit command: $CMD" >&2
    usage >&2
    exit 1
    ;;
esac
